# Caddy reverse proxy for rms (automatic TLS, HTTP/2, WebSocket, no buffering).
# WebRTC: WHEP signalling (/whep/...) is proxied below; the media is not. Browsers send
# ICE/DTLS/SRTP directly to webrtc.udp_port (default 8443/udp): open it on the server and set
# webrtc.public_ip to the public address behind NAT. Caddy cannot (and must not) proxy it.
stream.example.com {
    request_body {
        max_size 1100MB
    }
    reverse_proxy 127.0.0.1:8080 {
        flush_interval -1
        header_up X-Forwarded-Proto {scheme}
        transport http {
            read_timeout 1h
            write_timeout 1h
        }
    }
}
